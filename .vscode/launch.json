{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🌐 Launch Web Dashboard (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.port=8501",
                "--server.headless=false"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🤖 Run E-Commerce Chatbot (Interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/chatbot.py",
